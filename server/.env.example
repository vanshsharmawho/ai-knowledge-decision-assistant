# --- Server ---
PORT=5000
# Where the React app runs (allowed to call the admin APIs)
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of the React app, used to build assistant URLs and embed code
PUBLIC_APP_URL=http://localhost:5173

# --- Database ---
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/kb_assistant for local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/PDF_Chat_BOX?retryWrites=true&w=majority

# --- Auth ---
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- LLM providers ---
# Primary provider for question understanding, decisions and answers: groq or gemini
LLM_PROVIDER=groq
# Free key at https://console.groq.com (no card needed)
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_DECISION_MODEL=openai/gpt-oss-20b
# low = fast; enough for narrow structured tasks
GROQ_REASONING_EFFORT=low

# --- Gemini (used for embeddings, and as fallback LLM). Free key at https://aistudio.google.com ---
GEMINI_API_KEY=your-gemini-api-key
# Bigger model: understands/decomposes questions and writes final answers
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Small, fast model used for "System 1" structured decisions
GEMINI_DECISION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
LLM_TIMEOUT_MS=60000
# Used in order when a model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# 0 = no hidden 'thinking' on Gemini 2.5 Flash models (faster, avoids empty replies)
GEMINI_THINKING_BUDGET=0
# Optional for Gemini 3.x models, e.g. low (faster). Leave empty for the model default.
GEMINI_THINKING_LEVEL=

# --- Retrieval ---
# Set to true only after creating the Atlas Vector Search index (see README)
USE_ATLAS_VECTOR_SEARCH=false
ATLAS_VECTOR_INDEX=chunk_vector_index
# Below this cosine similarity AND with no keyword overlap, we answer "not in knowledge base"
MIN_SIMILARITY=0.45
# Below this evidence-sufficiency score (0-1), we answer "not in knowledge base"
MIN_SUFFICIENCY=0.35

# --- Storage (private, never served publicly) ---
STORAGE_DIR=./storage
